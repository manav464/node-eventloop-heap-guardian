{
  "name": "node-eventloop-heap-guardian",
  "version": "1.0.0",
  "description": "Lightweight, enterprise-grade in-process diagnostic agent for detecting memory leaks, heap growth anomalies, and event-loop lag in Node.js microservices",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "start": "node --no-warnings dist/examples/leakyServer.js"
  },
  "keywords": [
    "memory-leak",
    "heap-snapshot",
    "event-loop",
    "performance",
    "monitoring",
    "diagnostics",
    "prometheus",
    "v8"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "prom-client": "^15.1.0",
    "pino": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "express": "^4.18.2",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
